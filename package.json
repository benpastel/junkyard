{
  "name": "junkyard-armada",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "vitest run",
    "start": "npm run build && tsx server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "UNLICENSED"
}
